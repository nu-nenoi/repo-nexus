CUSTOM_CONFIG=""
[ -n "$RNEX_CONFIG" ] && CUSTOM_CONFIG="$RNEX_CONFIG"

ORIG_COUNT=$#
i=0
while [ "$i" -lt "$ORIG_COUNT" ]; do
  i=$((i + 1))
  case "$1" in
    --config=*)
      CUSTOM_CONFIG="${1#*=}"
      shift
      ;;
    --config|-c)
      [ -n "$2" ] || die "Option $1 requires a file path argument"
      CUSTOM_CONFIG="$2"
      shift 2
      i=$((i + 1))
      ;;
    *)
      _arg="$1"
      shift
      set -- "$@" "$_arg"
      ;;
  esac
done

case "${1:-help}" in
  init)        shift; cmd_init "$@" ;;
  install)     shift; cmd_install "$@" ;;
  add)         shift; cmd_add "$@" ;;
  clone)       shift; cmd_clone "$@" ;;
  exec)        shift; cmd_exec "$@" ;;
  remove)      shift; cmd_remove "$@" ;;
  enable)      shift; cmd_enable "$@" ;;
  disable)     shift; cmd_disable "$@" ;;
  show)        shift; cmd_show "$@" ;;
  hide)        shift; cmd_hide "$@" ;;
  list)        shift; cmd_list "$@" ;;
  status)      shift; cmd_status "$@" ;;
  hooks)       shift; cmd_hooks "$@" ;;
  update|upgrade) shift; cmd_update "$@" ;;
  rnex-dir)    shift; cmd_rnex_dir "$@" ;;
  fix|sync)    shift; cmd_fix "$@" ;;
  plugin)      shift; cmd_plugin "$@" ;;
  completion)  shift; cmd_completion "$@" ;;
  version|-v|--version) cmd_version ;;
  help|-h|--help) cmd_help ;;
  *)           die "Unknown command: $1 (try 'rnex help')" ;;
esac
